#!/bin/bash
# What the release workflow runs for a pushed v<version> tag: put that version on npm, then create the
# GitHub release with the plugin ZIP attached. Safe to re-run after a partial failure: a version that
# is already on npm is not published again, and an existing release only gets the ZIP re-attached.
# Usage: scripts/publish-release <tag>   needs npm auth (trusted publishing or NODE_AUTH_TOKEN) and GH_TOKEN
set -euo pipefail

cd "$(dirname "$0")/.."
tag="${1:?usage: scripts/publish-release <tag>}"
node scripts/sync-plugin-version.js --check --tag "$tag"
package="$(node -p "require('./package.json').name")"
version="${tag#v}"

if [ "$(npm view "$package@$version" version 2>/dev/null)" = "$version" ]; then
    echo "$package@$version is already on npm; not publishing it again."
else
    npm publish --provenance --access public
fi

# Not into dist/: the npm package ships that directory.
archive="$(scripts/pack-codex-plugin "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/code-evolve-plugin-$version.zip")"
if gh release view "$tag" >/dev/null 2>&1; then
    gh release upload "$tag" "$archive" --clobber
else
    gh release create "$tag" "$archive" --title "$tag" --generate-notes --verify-tag
fi
